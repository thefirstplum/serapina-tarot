# ─────────────────────────────────────────────
# 루트 .env — docker-compose 가 읽는 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# ─────────────────────────────────────────────

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=tarot_chat
MYSQL_USER=tarot_user
MYSQL_PASSWORD=change-me

# 백엔드
DATABASE_URL=mysql+aiomysql://tarot_user:change-me@mysql:3306/tarot_chat

# Ollama (호스트에서 직접 실행)
OLLAMA_API_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=gemma3:12b
OLLAMA_MODEL_LIGHT=gemma3:12b
OLLAMA_MODEL_HEAVY=gemma3:12b

# 암호화 / 세션 — 반드시 임의의 긴 문자열로 교체
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_PASSWORD=generate-a-long-random-string
SECRET_KEY=generate-a-long-random-string
JWT_SECRET_KEY=generate-a-long-random-string

# 서비스 정책
DAILY_USAGE_LIMIT=3
ALLOWED_HOSTS=localhost,127.0.0.1

# Anthropic API (선택 — Ollama 대신 Claude 사용 시)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
CLAUDE_MODEL_HEAVY=claude-sonnet-5

# 카카오 OAuth (선택 — 로그인 기능 사용 시)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 토스페이먼츠 (선택 — 결제 기능 사용 시)
TOSS_SECRET_KEY=
