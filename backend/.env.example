# 로컬에서 uvicorn을 직접 띄울 때 backend/.env로 복사해 쓴다.
# Docker로 띄우면 루트 .env를 읽으므로 이 파일은 필요 없다.

# docker compose의 mysql 컨테이너(루트 .env.example 기본값) 기준
DATABASE_URL=mysql+aiomysql://tarot_user:change-me@localhost:3306/tarot_chat

# Ollama
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL_LIGHT=qwen3.6:35b-a3b
OLLAMA_MODEL_HEAVY=qwen3.6:35b-a3b

# 비어 있으면 서버가 뜨지 않는다
ENCRYPTION_PASSWORD=generate-a-long-random-string
SECRET_KEY=generate-a-long-random-string

# 일일 리포트 메일 (daily_report.py, 선택)
# Gmail은 앱 비밀번호가 필요하다 (https://myaccount.google.com/apppasswords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=recipient@example.com
